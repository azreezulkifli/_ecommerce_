DATABASE_URL="file:./dev.db"
SESSION_SECRET="tukar-dengan-kunci-rahsia-anda-sendiri"

# Pilihan: "mock" untuk simulasi pembayaran (pembangunan sahaja) atau "gateway" untuk penyedia sebenar
NEXT_PUBLIC_PAYMENT_MODE="mock"

# Nombor WhatsApp kedai untuk pesanan ringkas (format antarabangsa tanpa "+", cth: 60123456789)
NEXT_PUBLIC_WHATSAPP_NUMBER="60123456789"

# Konfigurasi Payment Gateway Malaysia (contoh: HitPay / Stripe / senangPay)
# Isi nilai ini apabila akaun payment gateway anda sudah sedia:
#HITPAY_API_KEY=""
#HITPAY_SALT=""
#STRIPE_SECRET_KEY=""
#STRIPE_PUBLISHABLE_KEY=""
